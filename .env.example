# ==============================================================================
# University Event Management System (UEMS) - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env` in the project root:
#    copy .env.example .env
# 2. Update the values below to match your local setup (especially DB_PASSWORD).
# 3. Never commit `.env` containing sensitive credentials to Git.
# ==============================================================================

# Django Security Key (Use a unique, secret string in production)
DJANGO_SECRET_KEY=django-insecure-uems-project-local-dev-key-change-in-production-123456

# Debug Mode: True for development, False for production
DJANGO_DEBUG=True

# Allowed Hosts: Comma-separated domain names or IP addresses
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=uems_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Timezone
DJANGO_TIME_ZONE=UTC
